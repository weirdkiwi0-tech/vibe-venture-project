PORT=3001
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Comma-separated admin emails. Leave empty to make all users general(user).
GOOGLE_ADMIN_EMAILS=

# Local development only; keep this directory across server restarts.
UPLOADS_DIR=./data/uploads
# Production: private Blob container via managed identity (Storage Blob Data Contributor).
AZURE_STORAGE_ACCOUNT_URL=
AZURE_UPLOADS_CONTAINER=keepit-uploads
# Optional compatibility fallback; existing AZURE_TABLES_CONNECTION_STRING also works.
AZURE_BLOB_CONNECTION_STRING=
